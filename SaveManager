local cloneref = cloneref or clonereference or function(i) return i end
local clonefunction = clonefunction or copyfunction or function(f) return f end

local HttpService = cloneref(game:GetService("HttpService"))
local Players = cloneref(game:GetService("Players"))

-- Make is____ functions always return safely instead of erroring
local function safe(fn)
    local copy = clonefunction(fn)
    return function(...)
        local ok, res = pcall(copy, ...)
        return ok and res or (fn == listfiles and {} or false)
    end
end
isfolder, isfile, listfiles = safe(isfolder), safe(isfile), safe(listfiles)

local SaveManager = {
    Library = nil,
    Folder = "ObsidianLibSettings",
    SubFolder = "",
    Ignore = {},
    LoadingOrder = {},
    UseLoadingOrder = false,
    AutoloadConfig = nil,

    EasyConfigEnabled = false,
    EasyConfigName = nil,
    EasyConfigInterval = 5,
    EasyConfigThread = nil,
}

function SaveManager:SetLibrary(Library) SaveManager.Library = Library end

-- // UDim2 <-> table
local UDim2Codec = {
    Encode = function(v)
        return { X = { v.X.Scale, v.X.Offset }, Y = { v.Y.Scale, v.Y.Offset } }
    end,
    Decode = function(d)
        if typeof(d) == "UDim2" then return d end
        if typeof(d) == "table" then return UDim2.new(d.X[1], d.X[2], d.Y[1], d.Y[2]) end
        return nil
    end
}

-- // Element save/load parsers
local function simpleParser(get, apply)
    return {
        Save = function(idx, el) return { value = get(el) } end,
        Load = function(el, data)
            if not el then return end
            if el.Value == data.value then el:RunChanged() else apply(el, data) end
        end
    }
end

local ElementParser = {
    Toggle = simpleParser(function(t) return t.Value end, function(t, d) t:SetValue(d.value) end),
    Slider = simpleParser(function(s) return tostring(s.Value) end, function(s, d) s:SetValue(d.value) end),
    Dropdown = simpleParser(function(dd) return dd.Value end, function(dd, d) dd:SetValue(d.value) end),
    Input = {
        Save = function(idx, i) return { text = i.Value } end,
        Load = function(el, d)
            if not el or typeof(d.text) ~= "string" then return end
            if el.Value == d.text then el:RunChanged() else el:SetValue(d.text) end
        end
    },
    ColorPicker = {
        Save = function(idx, c) return { value = c.Value:ToHex(), transparency = c.Transparency } end,
        Load = function(el, d) if el then el:SetValueRGB(Color3.fromHex(d.value), d.transparency) end end
    },
    KeyPicker = {
        Save = function(idx, k) return { mode = k.Mode, key = k.Value, modifiers = k.Modifiers, toggled = k.Toggled } end,
        Load = function(el, d)
            if not el then return end
            el:SetValue({ d.key, d.mode, d.modifiers })
            if d.mode == "Toggle" and d.toggled ~= nil then
                el.Toggled = d.toggled
                el:Update()
            end
        end
    },
}

-- Groupbox / Tabbox share popout + collapse logic, keyed by tab
local function popoutParser(getCollapsed)
    return {
        Save = function(idx, box, tabIdx)
            return {
                tabIdx = tabIdx,
                collapsed = getCollapsed and box.Collapsed or nil,
                poppedOut = box.PoppedOut == true,
                popoutPos = (box.PoppedOut and box.PopOutFloat) and UDim2Codec.Encode(box.PopOutFloat.Position) or nil,
            }
        end,
        Load = function(_, d)
            if typeof(d.tabIdx) ~= "string" or typeof(d.idx) ~= "string" then return end
            local tab = SaveManager.Library and SaveManager.Library.Tabs[d.tabIdx]
            if not tab then return end
            local box = getCollapsed and tab.Groupboxes[d.idx] or (tab.Tabboxes and tab.Tabboxes[d.idx])
            if not box then return end

            if getCollapsed and box.Collapsed ~= d.collapsed then
                box:SetCollapsed(d.collapsed == true)
            end
            if box.PopOutEnabled then
                if d.poppedOut then
                    box:SetPoppedOut(true, UDim2Codec.Decode(d.popoutPos))
                elseif box.PoppedOut then
                    box:SetPoppedOut(false)
                end
            end
        end
    }
end
ElementParser.Groupbox = popoutParser(true)
ElementParser.Tabbox = popoutParser(false)

-- Where each element type lives on the Library, so Load() can fetch it by idx.
-- Groupbox/Tabbox look themselves up (via tabIdx) instead, so they're omitted here.
local ElementSource = {
    Toggle = "Toggles", Slider = "Options", Dropdown = "Options",
    Input = "Options", ColorPicker = "Options", KeyPicker = "Options",
}

-- Wrap every parser so Save() also tags type/idx, and Load() receives
-- the right element (or nil for Groupbox/Tabbox, which self-resolve).
for elementType, parser in pairs(ElementParser) do
    local rawSave, rawLoad = parser.Save, parser.Load
    parser.Save = function(idx, el, ...)
        local data = rawSave(idx, el, ...)
        data.type, data.idx = elementType, idx
        return data
    end

    local sourceKey = ElementSource[elementType]
    parser.Load = function(data)
        local el = sourceKey and SaveManager.Library and SaveManager.Library[sourceKey][data.idx]
        return rawLoad(el, data)
    end
end

-- // Helpers \\--
local function trim(s) return s:match("^%s*(.-)%s*$") end
local function isEmpty(s) return typeof(s) ~= "string" or trim(s) == "" end
local function isValidName(s) return typeof(s) == "string" and not isEmpty(s) and not s:find('[<>:"|%?%*%z]') end

local function splitPath(path)
    local result, current = {}, ""
    for part in path:gmatch("[^/]+") do
        current = current == "" and part or (current .. "/" .. part)
        table.insert(result, current)
    end
    return result
end

-- // Path resolution \\--
local function easyConfigFolder()
    if not SaveManager.EasyConfigEnabled or isEmpty(SaveManager.EasyConfigName) then return false end
    local player = Players.LocalPlayer
    if not player then return false end
    return string.format("!Maoya/%s", player.Name)
end

local function baseFolder()
    return isEmpty(SaveManager.Folder) and false or string.format("%s/settings", SaveManager.Folder)
end

local function subFolder()
    if isEmpty(SaveManager.Folder) or isEmpty(SaveManager.SubFolder) then return false end
    return string.format("%s/settings/%s", SaveManager.Folder, SaveManager.SubFolder)
end

local function settingsPath()
    return easyConfigFolder() or subFolder() or baseFolder()
end

local function configPath(name)
    local easy = easyConfigFolder()
    if easy then return string.format("%s/%s.json", easy, SaveManager.EasyConfigName) end
    local base = settingsPath()
    return base and string.format("%s/%s.json", base, name) or false
end

local function autoloadPath()
    local base = settingsPath()
    return base and string.format("%s/autoload.txt", base) or false
end

local function configExists(name)
    local p = configPath(name)
    return p ~= false and isfile(p)
end

-- // Indexes \\--
function SaveManager:SetLoadingOrder(enabled, order)
    SaveManager.UseLoadingOrder = enabled == true
    if typeof(order) == "table" then SaveManager.LoadingOrder = order end
end

function SaveManager:SetIgnoreIndexes(indexes)
    assert(typeof(indexes) == "table", "Expected table")
    for _, idx in indexes do SaveManager.Ignore[idx] = true end
end

function SaveManager:IgnoreThemeSettings()
    self:SetIgnoreIndexes({
        "BackgroundColor", "MainColor", "AccentColor", "OutlineColor", "FontColor", "FontFace", "BackgroundImage",
        "ThemeManager_ThemeList", "ThemeManager_CustomThemeList", "ThemeManager_CustomThemeName", "ThemeManager_ThemeJSON"
    })
end

-- // Folders \\--
function SaveManager:GetPaths()
    local path = easyConfigFolder() or subFolder() or baseFolder()
    return path and splitPath(path) or {}
end

function SaveManager:BuildFolderTree(skipIfExists)
    local paths = self:GetPaths()
    if #paths == 0 then return false end
    if skipIfExists and isfolder(paths[1]) then return true end
    for _, path in paths do
        if not isfolder(path) then makefolder(path) end
    end
    return true
end

function SaveManager:CheckFolderTree() return self:BuildFolderTree(true) end

function SaveManager:CheckSubFolder(create)
    local path = subFolder()
    if not path then return false end
    if create then makefolder(path); return true end
    return isfolder(path)
end

function SaveManager:SetFolder(folder)
    assert(isValidName(folder), "Invalid path provided")
    self.Folder = folder
    self:BuildFolderTree()
end

function SaveManager:SetSubFolder(sub)
    assert(isValidName(sub), "Invalid path provided")
    self.SubFolder = sub
    self:BuildFolderTree()
end

-- // Config list \\--
function SaveManager:RefreshConfigList()
    local path = settingsPath()
    if not path then return {} end

    pcall(makefolder, path)
    local ok, files = pcall(listfiles, path)
    if not (ok and typeof(files) == "table") then
        self.Library:Notify("Failed to load config list: " .. tostring(files))
        return {}
    end

    local names = {}
    for _, filePath in files do
        local raw = filePath:match("(.+)%..+$")
        if raw then
            local pos = raw:gsub("\\", "/"):find("/[^/]*$")
            local name = pos and raw:sub(pos + 1) or raw
            if name and name ~= "autoload" then table.insert(names, name) end
        end
    end
    return names
end

-- // Save / Load \\--
function SaveManager:SaveJSON(configName)
    local library, ignore = self.Library, self.Ignore
    local data = {
        timestamp = os.date("%d.%m.%Y %H:%M:%S"),
        name = configName or "",
        objects = {},
        keybindMenu = library.KeybindFrame and {
            visible = library.KeybindFrame.Visible,
            position = UDim2Codec.Encode(library.KeybindFrame.Position)
        } or nil
    }

    local function collect(list)
        for idx, el in list do
            local parser = el.Type and ElementParser[el.Type]
            if parser and not ignore[idx] then table.insert(data.objects, parser.Save(idx, el)) end
        end
    end
    collect(library.Toggles)
    collect(library.Options)

    for tabIdx, tab in library.Tabs do
        for _, groupName in { "Groupboxes", "Tabboxes" } do
            local group = tab[groupName]
            local parser = ElementParser[groupName == "Groupboxes" and "Groupbox" or "Tabbox"]
            if group then
                for idx, box in group do
                    if typeof(idx) == "string" and not ignore[idx] then
                        table.insert(data.objects, parser.Save(idx, box, tabIdx))
                    end
                end
            end
        end
    end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then return "", false, "Failed to encode data" end
    return encoded, true
end

function SaveManager:Save(configName)
    if isEmpty(configName) or configName:lower() == "autoload" then
        return false, "Invalid config name provided"
    end

    local path = configPath(configName)
    if not path then return false, "Invalid config name provided" end

    self:CheckFolderTree()
    local encoded, ok, err = self:SaveJSON(configName)
    if not ok then return false, err end

    local writeOk, writeErr = pcall(writefile, path, encoded)
    if not writeOk then return false, "Failed to write config file: " .. tostring(writeErr) end
    return true
end

function SaveManager:LoadJSON(content)
    if isEmpty(content) then return false, "No JSON provided" end

    local ok, decoded = pcall(HttpService.JSONDecode, HttpService, content)
    if not ok or typeof(decoded) ~= "table" or typeof(decoded.objects) ~= "table" then
        return false, "Failed to decode config data"
    end

    local library, order, ignore = self.Library, self.LoadingOrder, self.Ignore

    if self.UseLoadingOrder and typeof(order) == "table" then
        table.sort(decoded.objects, function(a, b)
            return (table.find(order, a.type) or math.huge) < (table.find(order, b.type) or math.huge)
        end)
    end

    if library.KeybindFrame and typeof(decoded.keybindMenu) == "table" then
        local kb = decoded.keybindMenu
        local visible = kb.visible == true
        library.KeybindFrame.Visible = visible
        library.KeybindFrame.Position = UDim2Codec.Decode(kb.position) or library.KeybindFrame.Position

        local toggle = library.Options and library.Options.KeybindMenuOpen
        if toggle then toggle:SetValue(visible) end
    end

    for _, obj in decoded.objects do
        local parser = obj.type and ElementParser[obj.type]
        if parser and not ignore[obj.idx] then
            task.defer(parser.Load, obj)
        end
    end

    return true
end

function SaveManager:Load(configName)
    if isEmpty(configName) then return false, "No config is selected" end

    local path = configPath(configName)
    if not path or not isfile(path) then return false, "Config file does not exist" end

    local ok, content = pcall(readfile, path)
    if not ok then return false, "Failed to read config file" end
    return self:LoadJSON(content)
end

function SaveManager:Delete(configName)
    if isEmpty(configName) then return false, "No config is selected" end

    local path = configPath(configName)
    if not path or not isfile(path) then return false, "Config file does not exist" end

    local ok, err = pcall(delfile, path)
    if not ok then return false, "Failed to delete config file: " .. tostring(err) end

    if configName == self.AutoloadConfig then self:DeleteAutoLoadConfig() end
    return true
end

-- // EasyConfig \\--
local function stopEasyConfigThread()
    if SaveManager.EasyConfigThread then
        task.cancel(SaveManager.EasyConfigThread)
        SaveManager.EasyConfigThread = nil
    end
end

-- Switches saving to workspace/!Maoya/<Player>/, loads any existing
-- autosave for `name`, then autosaves on a loop.
function SaveManager:EasyConfig(name)
    if isEmpty(name) or not isValidName(name) then return false, "Invalid name provided" end

    stopEasyConfigThread()
    self.EasyConfigEnabled = true
    self.EasyConfigName = name
    self:BuildFolderTree()

    if configExists(name) then
        local ok, err = self:Load(name)
        if not ok then
            self.Library:Notify(string.format("EasyConfig (%s): Failed to load existing config: %s", name, tostring(err)))
        end
    end

    self.EasyConfigThread = task.spawn(function()
        while self.EasyConfigEnabled and self.EasyConfigName == name do
            task.wait(self.EasyConfigInterval)
            if not (self.EasyConfigEnabled and self.EasyConfigName == name) then break end

            local ok, err = self:Save(name)
            if not ok then
                self.Library:Notify(string.format("EasyConfig (%s): Failed to save: %s", name, tostring(err)))
            end
        end
    end)

    return true
end

function SaveManager:StopEasyConfig()
    stopEasyConfigThread()
    self.EasyConfigEnabled = false
    self.EasyConfigName = nil
end

function SaveManager:SetEasyConfigInterval(seconds)
    assert(typeof(seconds) == "number" and seconds > 0, "Expected positive number")
    self.EasyConfigInterval = seconds
end

-- // Autoload \\--
function SaveManager:GetAutoloadConfig()
    self:CheckFolderTree()
    local path = autoloadPath()
    if not path then return "none", false, "Invalid path provided" end
    if not isfile(path) then return "none", false, "Autoload config is not set" end

    local ok, name = pcall(readfile, path)
    if not (ok and typeof(name) == "string") then return "none", false, name end
    if not configExists(name) then return "none", false, "Config file not found" end

    self.AutoloadConfig = name
    return name, true
end

function SaveManager:SaveAutoloadConfig(configName)
    if isEmpty(configName) then return false, "No config is selected" end
    self:CheckFolderTree()

    local path = autoloadPath()
    if not path then return false, "Invalid path provided" end
    if not configExists(configName) then return false, "Config does not exist" end

    local ok, err = pcall(writefile, path, configName)
    if not ok then return false, err end

    self.AutoloadConfig = configName
    return true
end

function SaveManager:LoadAutoloadConfig()
    local name, ok, err = self:GetAutoloadConfig()
    if not ok then
        if err ~= "Autoload config is not set" then
            self.Library:Notify("Failed to load autoload config: " .. tostring(err))
        end
        return
    end

    local loadOk, loadErr = self:Load(name)
    if not loadOk then
        self.Library:Notify("Failed to load autoload config: " .. tostring(loadErr))
        return
    end

    self.Library:Notify(string.format("Successfully loaded autoload config %q", name))
end

function SaveManager:DeleteAutoLoadConfig()
    self:CheckFolderTree()
    local path = autoloadPath()
    if not path then return false, "Invalid path provided" end
    if not isfile(path) then return false, "Autoload config is not set" end

    local ok, err = pcall(delfile, path)
    if not ok then return false, err end

    self.AutoloadConfig = nil
    return true
end

-- // GUI \\--
local function confirm(condition, index, title, description, actionText, action)
    if not condition() then return action() end

    return SaveManager.Library.Window:AddDialog(index, {
        Title = title,
        Description = description,
        AutoDismiss = false,
        FooterButtons = {
            Cancel = { Title = "Cancel", Variant = "Ghost", Order = 1, Callback = function(d) d:Dismiss() end },
            DestructiveAction = {
                Title = actionText, Variant = "Destructive", Order = 2,
                Callback = function(d) d:Dismiss(); action() end
            }
        }
    })
end

function SaveManager:BuildConfigSection(tab, iconName)
    assert(self.Library, "Library is not set, call SaveManager:SetLibrary(Library) first.")
    local box = tab:AddGroupbox({ Side = "Right", Name = "Configuration", IconName = iconName or "folder-cog" })

    local nameInput, list, jsonInput, autoloadLabel

    local function refreshList()
        list:SetValues(self:RefreshConfigList())
        list:SetValue(nil)
    end

    local function refreshAutoloadLabel()
        local name = self:GetAutoloadConfig()
        autoloadLabel:SetText("Current autoload config: " .. name)
        if list then refreshList() end
    end

    local function requireConfig(fn)
        return function()
            local name = list.Value
            if isEmpty(name) then self.Library:Notify("Please select a config first."); return end
            fn(name)
        end
    end

    -- Create
    box:AddInput("SaveManager_ConfigName", { Text = "Config name" })
    box:AddButton("Create config", function()
        local name = nameInput.Value
        if isEmpty(name) then self.Library:Notify("Configuration name cannot be empty."); return end
        if name:lower() == "autoload" then self.Library:Notify("Invalid config name provided."); return end

        confirm(function() return configExists(name) end,
            "SaveManager_CreateConfig", "Config already exists",
            string.format("A config named %q already exists. Overwriting will replace it with your current settings.", name),
            "Overwrite", function()
                local ok, err = self:Save(name)
                if not ok then self.Library:Notify(string.format("Failed to create config %q: %s", name, err)); return end
                self.Library:Notify(string.format("Successfully created config %q", name))
                refreshList()
            end)
    end)

    box:AddDivider()

    -- Manage
    box:AddDropdown("SaveManager_ConfigList", {
        Text = "Config list",
        Values = self:RefreshConfigList(),
        AllowNull = true,
        Multi = false,
        FormatDisplayValue = function(v) return v == self.AutoloadConfig and (v .. " (autoload)") or v end,
        FormatListValue = function(v) return v == self.AutoloadConfig and (v .. " (autoload)") or v end
    })

    box:AddButton({ Text = "Load config", Func = requireConfig(function(name)
        confirm(function() return true end, "SaveManager_LoadConfig", "Load config",
            string.format("Are you sure you want to load %q? Your current settings will be overwritten.", name),
            "Load", function()
                local ok, err = self:Load(name)
                if ok then self.Library:Notify(string.format("Successfully loaded config %q", name))
                else self.Library:Notify(string.format("Failed to load config %q: %s", name, err)) end
            end)
    end) })

    box:AddButton({ Text = "Overwrite config", Func = requireConfig(function(name)
        confirm(function() return true end, "SaveManager_OverwriteConfig", "Overwrite config",
            string.format("Are you sure you want to overwrite %q with your current settings? This cannot be undone.", name),
            "Overwrite", function()
                local ok, err = self:Save(name)
                if ok then self.Library:Notify(string.format("Successfully overwrote config %q", name))
                else self.Library:Notify(string.format("Failed to overwrite config %q: %s", name, err)) end
            end)
    end) })

    box:AddButton({ Text = "Delete config", Func = requireConfig(function(name)
        confirm(function() return true end, "SaveManager_DeleteConfig", "Delete config",
            string.format("Are you sure you want to delete %q? This cannot be undone.", name),
            "Delete", function()
                local ok, err = self:Delete(name)
                if ok then
                    self.Library:Notify(string.format("Successfully deleted config %q", name))
                    refreshAutoloadLabel()
                else
                    self.Library:Notify(string.format("Failed to delete config %q: %s", name, err))
                end
            end)
    end) })

    box:AddButton("Refresh list", refreshList)

    -- Autoload
    box:AddButton({ Text = "Set as autoload", Func = requireConfig(function(name)
        local ok, err = self:SaveAutoloadConfig(name)
        if ok then
            self.Library:Notify(string.format("Successfully set autoload config to %q", name))
            refreshAutoloadLabel()
        else
            self.Library:Notify(string.format("Failed to set autoload config %q: %s", name, err))
        end
    end) })

    box:AddButton({ Text = "Reset autoload", Func = function()
        confirm(function() return true end, "SaveManager_ResetAutoload", "Reset autoload config",
            "Are you sure you want to clear the autoload config? No config will be loaded automatically on next launch.",
            "Reset", function()
                local ok, err = self:DeleteAutoLoadConfig()
                if ok then
                    self.Library:Notify("Successfully reset autoload config.")
                    refreshAutoloadLabel()
                else
                    self.Library:Notify("Failed to reset autoload config: " .. tostring(err))
                end
            end)
    end })

    autoloadLabel = box:AddLabel("Current autoload config: ...", true)
    box:AddDivider()

    -- Import / Export
    box:AddInput("SaveManager_JSON", { Text = "Config JSON" })
    box:AddButton("Import config", function()
        local json = jsonInput.Value
        if isEmpty(json) then self.Library:Notify("Configuration JSON cannot be empty"); return end

        confirm(function() return true end, "SaveManager_ImportConfig", "Import config",
            "Are you sure you want to import this configuration? Your current settings will be overwritten.",
            "Import", function()
                local ok, err = self:LoadJSON(json)
                if ok then self.Library:Notify("Successfully imported config")
                else self.Library:Notify("Failed to import config: " .. tostring(err)) end
            end)
    end)

    box:AddButton("Export current config", function()
        local encoded, ok, err = self:SaveJSON()
        if not ok then self.Library:Notify(err); return end

        jsonInput:SetValue(encoded)
        if setclipboard then
            setclipboard(encoded)
            self.Library:Notify("Copied config to your clipboard")
        end
    end)

    nameInput, list, jsonInput =
        self.Library.Options.SaveManager_ConfigName,
        self.Library.Options.SaveManager_ConfigList,
        self.Library.Options.SaveManager_JSON

    refreshAutoloadLabel()
    self:SetIgnoreIndexes({ "SaveManager_ConfigList", "SaveManager_ConfigName", "SaveManager_JSON" })

    return box
end

SaveManager:BuildFolderTree()
return SaveManager
